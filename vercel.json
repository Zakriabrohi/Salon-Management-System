{
  "version": 2,
  "outputDirectory": "public",
  "builds": [
    {
      "src": "public/index.php",
      "use": "vercel-php@0.8.0",
      "config": {
        "maxExecutionTime": 60,
        "phpVersion": "8.3"
      }
    }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.php"
    }
  ]
}
